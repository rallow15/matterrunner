# ============================================
#  .gitignore Unity — MatterRunner
#  Tout ce qui est généré/éphémère ne part PAS sur GitHub.
#  (le Mac distant de Codemagic regénère Library/Build lui-même)
# ============================================

# Dossiers générés par Unity
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/

# Sorties de build (produites sur le Mac de Codemagic)
build_xcode/
*.apk
*.aab
*.ipa

# Projets Visual Studio / Rider
.vs/
.vscode/
.idea/
*.csproj
*.sln
*.slnx
*.user
*.unityproj
*.suo
*.pidb
*.booproj
*.svd

# Crash / captures système
*.sysinfo
crashlytics-build.properties
sysinfo.txt

# Fichiers OS (Windows / Mac)
Thumbs.db
Desktop.ini
.DS_Store